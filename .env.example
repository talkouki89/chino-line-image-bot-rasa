# ============================================================
# Chino LINE Image Bot Rasa 環境變數範例
# 複製成 .env 後再填值：
#   PowerShell: Copy-Item .env.example .env
#
# 標籤說明：
# [必填] 沒填會影響啟動或 LINE webhook。
# [選填] 只在使用對應功能時需要。
# [進階] 通常保留預設，排查或部署時再調整。
# ============================================================


# ============================================================
# Rasa / HTTP
# ============================================================

# [選填] Rasa server 監聽 port。Rasa 預設是 5005。
PORT=5005

# [必填] 你的公開 HTTPS 網址，不含結尾斜線。
# LINE webhook 與本機下載媒體轉公開 URL 都會用到。
# 範例：https://example.ngrok-free.app
PUBLIC_BASE_URL=

# [選填] Bot 顯示時間使用的時區。
# 預設台灣時間；可填 Asia/Taipei、UTC+8、UTC-5。
BOT_TIMEZONE=Asia/Taipei


# ============================================================
# LINE 官方 Messaging API
# ============================================================

# [必填] LINE Developers > Messaging API > Channel access token。
# 也相容舊名稱 LINE_ACCESS_TOKEN；新專案建議用 LINE_CHANNEL_ACCESS_TOKEN。
LINE_CHANNEL_ACCESS_TOKEN=

# [必填] LINE Developers > Basic settings > Channel secret。
LINE_CHANNEL_SECRET=

# [必填] Bot 作者 / 最高管理員的 LINE userId。
# 官方 Bot 取得的是 U 開頭 userId，不是 CHRLINE MID。
Creator=

# [選填] 多位管理員 userId，以逗號分隔。
# 範例：ADMIN_USER_IDS=Uxxxx,Uyyyy
ADMIN_USER_IDS=

# [選填] 舊專案相容欄位。若插件仍讀 ADMIN_MIDS，會與 ADMIN_USER_IDS 一起視為管理員。
ADMIN_MIDS=


# ============================================================
# 外掛 / 熱載入
# ============================================================

# [選填] 是否啟用 plugins/ 熱載入。
# true 時修改 plugins/*.py 後，下一次訊息會自動重載，不需要重啟 Rasa。
HOT_RELOAD_PLUGINS=true

# [選填] 是否啟用最低入群人數限制。官方 Messaging API 無法接受/拒絕邀請，
# 此欄位保留給相容外掛與未來擴充。
GROUP_MIN_MEMBER_CHECK=true

# [選填] 最低入群人數。
GROUP_MIN_MEMBERS=10


# ============================================================
# PicImageSearch / 以圖搜圖
# ============================================================

# [選填] SauceNAO API key。
# 使用「回覆搜1 / 模板搜1 / #1」建議填。
# 取得網址：https://saucenao.com/user.php?page=search-api
SauceNAO_api_key=

# [選填] PicImageSearch proxy，例如 http://127.0.0.1:7890。
PICSEARCH_PROXIES=

# [選填] PicImageSearch timeout 秒數。網路慢時可調高。
PICSEARCH_TIMEOUT=60

# [選填] 是否驗證 SSL。
PICSEARCH_VERIFY_SSL=true

# [選填] Ascii2D 入口清單，逗號分隔。
ASCII2D_BASE_URLS=https://ascii2d.net

# [選填] Yandex 入口清單，逗號分隔。
YANDEX_BASE_URLS=https://yandex.ru,https://ya.ru


# ============================================================
# 圖床 / 下載 / 外部服務
# ============================================================

# [選填] Freeimage.host API key。
# 使用「#圖片上傳」時必填。
# API 說明：https://freeimage.host/page/api
FREEIMAGE_API_KEY=

# [選填] yt-dlp 執行檔名稱或完整路徑。
YTDLP_BIN=yt-dlp

# [選填] yt-dlp cookie 檔案路徑。
# 下載 YouTube / X / IG 等需要登入或年齡限制內容時使用。
YTDLP_COOKIES_FILE=cookies.txt

# [選填] 讓 yt-dlp 直接讀瀏覽器 cookie。
# 可填 chrome、edge、firefox；也可填 chrome,Default 指定 profile。
YTDLP_COOKIES_FROM_BROWSER=

# [選填] 直接貼 cookie 字串。IG / TikTok 圖片 fallback 解析時會使用。
YTDLP_COOKIE=

# [選填] Instaloader session 使用者名稱。
# 若 IG 公開貼文抓不到，可先執行：instaloader -l 使用者名稱
INSTALOADER_SESSION_USER=

# [選填] TikTok 圖片解析 API。預設使用 https://douyin.wtf。
DOUYIN_WTF_API_BASE=https://douyin.wtf

# [選填] nHentai cookie。遇到 403 或需要個人化結果再填。
NHENTAI_COOKIE=


# ============================================================
# 舊專案相容 / 低階設定
# ============================================================

# [選填] 舊版 LINE_ACCESS_TOKEN 相容欄位。
LINE_ACCESS_TOKEN=

# [選填] 後台通知聊天室/群組 ID。官方 API 不能列出所有群組，只會記錄互動過的群組。
Dio_GID=

# [選填] 啟動通知。保留給未來背景工作使用。
SEND_STARTUP_NOTIFY=false

# [選填] Speedtest 下載測試 URL。
SPEEDTEST_URL=https://speed.cloudflare.com/__down?bytes=10000000
